pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh './mvnw -DskipTests clean package'
            }
        }

        stage('Test') {
            steps {
                sh './mvnw test -Dspring.docker.compose.skip.in-tests=true'
            }
        }
    }

    post {
        always {
            junit '**/target/surefire-reports/*.xml'
        }
    }
}